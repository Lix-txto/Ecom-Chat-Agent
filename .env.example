# .env.example — 复制为 .env 并填入真实值
# 数据库
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=knowledge_base
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/knowledge_base

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=please-generate-a-64-char-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Chat 模型：DeepSeek 
DEEPSEEK_API_KEY=sk-
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat
# 需要深度推理时换 deepseek-reasoner

# Embedding 模型：硅基流动
SILICONFLOW_API_KEY=sk-
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# 通用开关（如果你的框架强制要求一个 LLM_PROVIDER）
LLM_PROVIDER=openai   # 两边都兼容 OpenAI 协议，保持 openai 即可
